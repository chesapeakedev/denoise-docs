---
import Default from "@astrojs/starlight/components/Hero.astro";
import denoiseLogo from "../assets/denoise-logo.png";

const PAGE_TITLE_ID = "_top";
const isHomepage = Astro.locals.starlightRoute.id === "";
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline } = data.hero || {};
---

{
  isHomepage ? (
    <div class="home-hero">
      <div class="home-hero__copy">
        <div class="home-hero__brand">
          <img
            class="home-hero__logo"
            src={denoiseLogo.src}
            width="88"
            height="88"
            alt=""
            decoding="async"
          />
          <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
        </div>
        {tagline && <div class="home-hero__blurb" set:html={tagline} />}
      </div>
    </div>
  ) : (
    <Default />
  )
}

<style>
  @layer starlight.core {
    .home-hero {
      position: relative;
      padding-block: clamp(1.25rem, 3vw, 2rem) clamp(0.5rem, 1.5vw, 1rem);
      animation: home-hero-enter 0.45s ease-out both;
    }

    .home-hero__copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
      width: 100%;
    }

    .home-hero__brand {
      display: flex;
      align-items: center;
      gap: 0.85rem 1rem;
      flex-wrap: wrap;
    }

    .home-hero__logo {
      width: clamp(3.25rem, 8vw, 5.5rem);
      height: auto;
      flex-shrink: 0;
    }

    .home-hero h1 {
      margin: 0;
      font-size: clamp(
        var(--sl-text-3xl),
        calc(0.4rem + 4vw),
        var(--sl-text-5xl)
      );
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
      letter-spacing: -0.02em;
    }

    .home-hero__blurb {
      font-size: clamp(
        var(--sl-text-base),
        calc(0.05rem + 1.2vw),
        var(--sl-text-lg)
      );
      line-height: 1.55;
      color: var(--sl-color-gray-2);
    }

    .home-hero__blurb :global(p) {
      margin: 0;
    }

    .home-hero__blurb :global(p + p) {
      margin-top: 0.75rem;
    }

    .home-hero__blurb :global(a) {
      color: var(--sl-color-gray-1);
      text-decoration: underline;
      text-decoration-color: color-mix(
        in srgb,
        var(--sl-color-gray-3) 70%,
        transparent
      );
      text-underline-offset: 0.15em;
    }

    .home-hero__blurb :global(a:hover) {
      color: var(--sl-color-accent-high);
      text-decoration-color: currentColor;
    }

    .home-hero__blurb :global(strong),
    .home-hero__blurb :global(code) {
      color: var(--sl-color-white);
      font-weight: 600;
    }

    .home-hero__blurb :global(code) {
      font-size: 0.92em;
      font-weight: 500;
    }
  }

  @keyframes home-hero-enter {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-hero {
      animation: none;
    }
  }
</style>
