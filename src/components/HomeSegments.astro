---
const segments = [
  {
    title: "Software Engineer",
    description:
      "Streamline your GitHub use and ship faster in the terminal or your favorite agent harness",
    links: [
      { title: "Installation", href: "/dn/installation/" },
      {
        title: "Completing GitHub Issues",
        href: "/dn/completing-github-issues/",
      },
      { title: "Command reference", href: "/dn/workflows/" },
      { title: "Cookbooks", href: "/cookbooks/overview/" },
      { title: "Headless Use", href: "/dn/headless-use/" },
    ],
  },
  {
    title: "Product Manager",
    description:
      "Plan your project, build from the browser, and keep the team in sync from Github",
    links: [
      { title: "Getting started", href: "/denoise/getting-started/" },
      { title: "The Void", href: "/denoise/void/" },
      { title: "Milestone details", href: "/denoise/milestone-details/" },
      { title: "GitHub integration", href: "/denoise/github-integration/" },
      {
        title: "Subscription & Pro",
        href: "/denoise/subscription-and-pro/",
      },
    ],
  },
  {
    title: "DevOps",
    description:
      "Build your software factory using your team's current hardware as infra",
    links: [
      {
        title: "Self-hosted runners",
        href: "/operations/self-hosted-runners/",
      },
      {
        title: "Scheduled Workflows",
        href: "/dn/scheduled-workflows/",
      },
      { title: "GitHub token setup", href: "/dn/github-token-setup/" },
      { title: "Progress reporting", href: "/dn/progress-reporting/" },
    ],
  },
];

const moreLinks = [{ title: "Introduction", href: "/introduction/" }];
---

<section class="home-segments not-content" aria-labelledby="home-segments-heading">
  <div class="home-segments__intro">
    <h2 id="home-segments-heading">Start by role</h2>
    <p>
      Jump to high-value pages for Software Engineers, Product Managers, or DevOps.
    </p>
  </div>

  <div class="home-segments__grid">
    {
      segments.map((segment) => (
        <article class="home-segment">
          <h3 class="home-segment__title">{segment.title}</h3>
          <p class="home-segment__desc">{segment.description}</p>
          <ul class="home-segment__links">
            {segment.links.map((link) => (
              <li>
                <a href={link.href}>{link.title}</a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <p class="home-segments__more">
    Also useful:{" "}
    {
      moreLinks.map((link, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={link.href}>{link.title}</a>
        </>
      ))
    }
  </p>
</section>

<style>
  .home-segments {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-block: 0.5rem 2.5rem;
    animation: home-segment-enter 0.5s ease-out 0.08s both;
  }

  .home-segments__intro h2 {
    margin: 0 0 0.5rem;
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .home-segments__intro p {
    margin: 0;
    max-width: 40rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-base);
  }

  .home-segments__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 50rem) {
    .home-segments__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .home-segment {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    height: 100%;
    min-height: 100%;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--sl-color-gray-6) 55%, transparent);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .home-segment:hover {
    border-color: color-mix(
      in srgb,
      var(--sl-color-accent) 45%,
      var(--sl-color-gray-5)
    );
    background: color-mix(in srgb, var(--sl-color-gray-6) 80%, transparent);
  }

  .home-segment__title {
    margin: 0;
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .home-segment__desc {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .home-segment__links {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: flex-start;
    gap: 0.5rem;
  }

  .home-segment__links li {
    display: contents;
    margin: 0;
    padding: 0;
  }

  .home-segment__links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin: 0;
    min-height: 2rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999rem;
    border: 1px solid var(--sl-color-gray-5);
    background: color-mix(in srgb, var(--sl-color-black) 35%, transparent);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    line-height: 1.25;
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .home-segment__links a:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    background: color-mix(in srgb, var(--sl-color-accent-low) 35%, transparent);
  }

  .home-segments__more {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .home-segments__more a {
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }

  .home-segments__more a:hover {
    color: var(--sl-color-accent-high);
  }

  @keyframes home-segment-enter {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-segments {
      animation: none;
    }
  }
</style>
