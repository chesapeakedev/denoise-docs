---
{/* Single pill toggle: Dark | Light (moon | sun). Uses data-theme and localStorage('theme'). */}
---

<div class="theme-switcher" role="group" aria-label="Theme options">
  <div
    class="theme-switch theme-mode-switch"
    role="group"
    aria-label="Dark or light mode"
    data-value="dark"
  >
    <span class="theme-switch-thumb" aria-hidden="true"></span>
    <button
      type="button"
      class="theme-switch-option"
      data-mode="dark"
      aria-pressed="true"
      aria-label="Dark mode"
    >
      <svg
        class="theme-switch-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>
    <button
      type="button"
      class="theme-switch-option"
      data-mode="light"
      aria-pressed="false"
      aria-label="Light mode"
    >
      <svg
        class="theme-switch-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5" />
        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
      </svg>
    </button>
  </div>
</div>

<script is:inline>
	StarlightThemeProvider.updatePickers();
</script>

<script>
	(function () {
		const STORAGE_KEY = "theme";

		function getTheme(): string {
			const raw = document.documentElement.dataset.theme ?? "";
			return raw === "dark" || raw === "light" ? raw : "dark";
		}

		function setTheme(mode: string): void {
			if (mode !== "dark" && mode !== "light") return;
			document.documentElement.dataset.theme = mode;
			try {
				localStorage.setItem(STORAGE_KEY, mode);
			} catch {
				/* ignore storage errors (e.g. private mode) */
			}
		}

		function syncUI(): void {
			const mode = getTheme();
			const modeSwitch = document.querySelector(".theme-mode-switch") as HTMLElement | null;
			if (modeSwitch) modeSwitch.dataset.value = mode;
			document.querySelectorAll(".theme-switch-option[data-mode]").forEach((el) => {
				const btn = el as HTMLButtonElement;
				btn.setAttribute("aria-pressed", btn.dataset.mode === mode ? "true" : "false");
			});
		}

		function onModeClick(e: Event): void {
			const btn = (e.target as HTMLElement).closest(".theme-switch-option[data-mode]") as HTMLButtonElement | null;
			if (!btn?.dataset.mode) return;
			setTheme(btn.dataset.mode);
			syncUI();
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", syncUI);
		} else {
			syncUI();
		}

		document.querySelectorAll(".theme-mode-switch .theme-switch-option").forEach((el) => el.addEventListener("click", onModeClick));
	})();
</script>
