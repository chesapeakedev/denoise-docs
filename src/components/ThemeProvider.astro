---
{/* FOUC: set data-theme (dark|light) from localStorage('theme') or system. */}
---

<script is:inline>
	window.StarlightThemeProvider = (function () {
		var stored = typeof localStorage !== "undefined" && localStorage.getItem("theme");
		var theme = stored === "dark" || stored === "light"
			? stored
			: (typeof matchMedia !== "undefined" && matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
		document.documentElement.dataset.theme = theme;
		return {
			updatePickers() {
				document.querySelectorAll(".theme-mode-switch").forEach(function (el) {
					el.dataset.value = document.documentElement.dataset.theme || "dark";
				});
				document.querySelectorAll(".theme-switch-option[data-mode]").forEach(function (btn) {
					btn.setAttribute("aria-pressed", btn.dataset.mode === (document.documentElement.dataset.theme || "dark") ? "true" : "false");
				});
			},
		};
	})();
</script>
